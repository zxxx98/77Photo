<?xml version="1.0" encoding="utf-8"?>
<!--
  The app accepts cleartext only after its runtime URL policy has confirmed an
  IP literal is inside the enabled LAN CIDRs and the user has confirmed the
  risk. Android's XML format cannot represent those user-editable CIDRs, so
  the dynamic boundary is enforced by the JS and native request layers.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
